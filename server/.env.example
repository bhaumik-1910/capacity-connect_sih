# ==============================================================================
# CAPACITY CONNECT - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Ministry of Earth Sciences (MoES) | India Meteorological Department (IMD)
# Problem Statement ID: 26075 | Theme: Smart Education
# Standard: National Digital Education Architecture (NDEAR) Aligned
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/capacity_connect

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. CLIENT & CORS INTEGRATION
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. GOVERNMENT ENTITY METADATA
# ------------------------------------------------------------------------------
GOV_ORGANIZATION_NAME="India Meteorological Department (IMD)"
GOV_MINISTRY_NAME="Ministry of Earth Sciences (MoES)"
GOV_PROBLEM_STATEMENT_ID="26075"
GOV_PORTAL_NAME="CAPACITY CONNECT"

# ------------------------------------------------------------------------------
# 6. CERTIFICATE AUTHORITY & SNAPSHOTTING DEFAULTS
# ------------------------------------------------------------------------------
CERT_DEFAULT_ORGANIZATION="India Meteorological Department (IMD)"
CERT_SIGNATORY_NAME="Dr. Mrutyunjay Mohapatra"
CERT_SIGNATORY_DESIGNATION="Director General of Meteorology, IMD & Permanent Rep of India with WMO"
CERT_PASSING_PERCENTAGE_DEFAULT=60
CERT_MINIMUM_ATTENDANCE_PERCENTAGE=75

# ------------------------------------------------------------------------------
# 7. AUDIT & LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
LOG_LEVEL=info
