# ==============================================================================
# CAPACITY CONNECT - FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Ministry of Earth Sciences (MoES) | India Meteorological Department (IMD)
# Problem Statement ID: 26075 | Theme: Smart Education
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=/api/v1

# Portal Branding & Identification
VITE_APP_TITLE="CAPACITY CONNECT"
VITE_APP_SUBTITLE="Digital Capacity Building & Learning Management Portal"
VITE_ORGANIZATION_NAME="Ministry of Earth Sciences (MoES)"
VITE_DEPARTMENT_NAME="India Meteorological Department (IMD)"
VITE_PROBLEM_STATEMENT_ID="26075"

# Environment Mode
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_DEMO_ROLE_SWITCHER=true
VITE_ENABLE_PUBLIC_VERIFICATION=true
VITE_ENABLE_AUDIT_LOGGING=true

# Public Certificate Verification Base URL
VITE_VERIFICATION_BASE_URL=http://localhost:5173/verify
